# Optional: Provide one of the API keys below to use cloud LLMs.
# If neither is set, the system automatically runs with a built-in offline
# extractive RAG generator or local Ollama.

# Google Gemini API Key (recommended: free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Ollama settings (for 100% local models without API keys)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

